diff --git a/catalog/reduce.py b/catalog/reduce.py
index 735bfb0..17aeda8 100644
--- a/catalog/reduce.py
+++ b/catalog/reduce.py
@@ -1,11 +1,43 @@
-"""Resolve imported time intervals into an installed schedule index."""
+"""Sweep interval boundaries; retain deletion barriers for future replays."""
 from __future__ import annotations
 from collections.abc import Iterable
+from collections import defaultdict
+from heapq import heappush, heappop
 from .model import Entry
 
 def reduce_entries(entries: Iterable[Entry]) -> dict[tuple[str, int, int], Entry]:
-    result: dict[tuple[str, int, int], Entry] = {}
+    spaces: dict[str, list[Entry]] = defaultdict(list)
     for entry in entries:
-        if not entry.deleted:
-            result[entry.identity] = entry
+        spaces[entry.space].append(entry)
+    result: dict[tuple[str, int, int], Entry] = {}
+    for space, rows in spaces.items():
+        events: dict[int, list[tuple[int, bool]]] = defaultdict(list)
+        for i, entry in enumerate(rows):
+            events[entry.start].append((i, True))
+            events[entry.end].append((i, False))
+        points = sorted(events)
+        active: set[int] = set()
+        heap: list[tuple[int, int, int]] = []
+        segments: list[Entry] = []
+        for offset, point in enumerate(points[:-1]):
+            for i, added in events[point]:
+                if added:
+                    active.add(i)
+                    heappush(heap, (-rows[i].revision, i, i))
+                else:
+                    active.discard(i)
+            while heap and heap[0][2] not in active:
+                heappop(heap)
+            if not heap:
+                continue
+            winner = rows[heap[0][2]]
+            end = points[offset+1]
+            if segments and segments[-1].end == point and (
+                segments[-1].revision, segments[-1].value, segments[-1].deleted
+            ) == (winner.revision, winner.value, winner.deleted):
+                segments[-1] = segments[-1].bounded(segments[-1].start, end)
+            else:
+                segments.append(winner.bounded(point,end))
+        for segment in segments:
+            result[segment.identity] = segment
     return result
